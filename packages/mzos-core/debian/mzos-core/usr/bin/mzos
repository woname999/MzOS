#!/usr/bin/env bash

VERSION="0.1.0-dev"
EDITION="Gaming"

show_version() {
    echo "MzOS ${EDITION} Edition"
    echo "Version : ${VERSION}"
    echo
    echo "Status  : Development"
}

show_info() {
    echo "MzOS System Information"
    echo
    echo "Edition : ${EDITION}"
    echo "Version : ${VERSION}"
    echo "Base    : Debian 13 (Trixie)"
    echo "Desktop : KDE Plasma"
}

show_health() {
    echo "MzOS Health Check"
    echo
    echo "Status : Not implemented"
}

show_install() {
    echo "MzOS Package Installer"
    echo
    echo "Status : Not implemented"
}

show_update() {
    echo "MzOS Update System"
    echo
    echo "Status : Not implemented"
}

show_help() {
    echo "MzOS command line interface"
    echo
    echo "Usage:"
    echo "  mzos version   Show version"
    echo "  mzos info      Show system information"
    echo "  mzos health    Run health check"
    echo "  mzos install   Install component"
    echo "  mzos update    Update system"
    echo "  mzos help      Show help"
}

case "${1}" in
    version)
        show_version
        ;;

    info)
        show_info
        ;;

health)
   MODULE="/usr/lib/mzos/modules/health/check.sh"

   if [ -x "$MODULE" ]; then
       shift
       exec "$MODULE" "$@"
   else
       echo "Health module is not installed."
       exit 1
   fi
   ;;

    install)
        show_install
        ;;

    update)
        show_update
        ;;

    help|"")
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac
