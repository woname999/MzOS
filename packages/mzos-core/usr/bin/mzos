#!/usr/bin/env bash

VERSION="0.1.0-dev"
EDITION="Gaming"

show_version() {
    echo "MzOS ${EDITION} Edition"
    echo "Version : ${VERSION}"
    echo
    echo "Status  : Development"
}

show_info() {
    echo "MzOS System Information"
    echo
    echo "Edition : ${EDITION}"
    echo "Version : ${VERSION}"
    echo "Base    : Debian 13 (Trixie)"
    echo "Desktop : KDE Plasma"
}

show_help() {
    echo "MzOS command line interface"
    echo
    echo "Usage:"
    echo
    echo "  mzos version              Show version"
    echo "  mzos info                 Show system information"
    echo "  mzos health               Run health check"
    echo
    echo "  mzos install <module>     Install module"
    echo "  mzos status <module>      Module status"
    echo "  mzos uninstall <module>   Uninstall module"
}

run_module() {

    ACTION="$1"
    MODULE="$2"

    SCRIPT="/usr/lib/mzos/modules/${MODULE}/${ACTION}.sh"

    if [ -x "$SCRIPT" ]; then
        exec "$SCRIPT"
    fi

    echo "Error: module '$MODULE' does not provide action '$ACTION'."
    exit 1
}


case "${1}" in

    version)
        show_version
        ;;

    info)
        show_info
        ;;

    health)
        MODULE="/usr/lib/mzos/modules/health/check.sh"

        if [ -x "$MODULE" ]; then
            exec "$MODULE" "$@"
        else
            echo "Health module is not installed."
            exit 1
        fi
        ;;

    install|status|uninstall)

        if [ -z "$2" ]; then
            echo "Usage: mzos $1 <module>"
            exit 1
        fi

        run_module "$1" "$2"
        ;;

    help|"")
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;

esac
